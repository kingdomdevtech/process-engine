# ── Windows host: the shared database + the engine (Excel/COM) ─────────────────
#
# This host does all the work: every run, every step preview, and its own cron.
# It serves no HTTP in either direction — the database is the only thing between
# it and the Linux container. Start one process per concurrent run:
#   python -m process_engine
#
# Install core and the engine, and not the API:
#   pip install ./packages/process_engine_core "./packages/process_engine[excel,mysql]"
# Add [aws] or [azure] if your processes use the SES, S3 or Azure blob steps.
# No web stack out here at all — process-engine has no fastapi, no uvicorn, and
# nothing on this host listens.
#
# PowerShell does not load .env files. Set the variables in the session first,
# then start the engine:
#   Get-Content deploy\windows-worker.env |
#     Where-Object { $_ -and $_ -notmatch '^\s*#' } |
#     ForEach-Object { $name, $value = $_ -split '=', 2; Set-Item "Env:$name" $value }
#   python -m process_engine
#
# There is no mode to switch on: an engine polls the queue, and the API cannot
# execute anything, so starting this is what makes runs happen at all.

# Same shared database as the Linux API. Local to this host, so 127.0.0.1.
PROCESS_ENGINE_DB_URL=mysql+pymysql://process_engine:CHANGE_ME@127.0.0.1:3306/process_engine

# MUST match the Linux API's value exactly, or the worker cannot decrypt the
# secrets your steps use or the stored mail-relay credentials.
PROCESS_ENGINE_SECRET_KEY=CHANGE_ME_shared_fernet_key

# Run-notification links point at the designer, and this host is what sends
# them. Use the same value as the Linux container's PROCESS_ENGINE_DESIGNER_URL
# so "Open the run" resolves for recipients.
PROCESS_ENGINE_DESIGNER_URL=https://engine.example.com

# Filesystem sandbox root for steps that read/write files (Excel, downloads).
# Every plugin path resolves inside this; keep it off the system drive root.
PROCESS_ENGINE_WORK_DIR=C:\ProcessEngine\workdir

# Threads per run for parallel steps. Optional.
#PROCESS_ENGINE_STEP_WORKERS=8

# Queue poll interval (seconds) and log level. Optional.
#PROCESS_ENGINE_QUEUE_POLL_SECONDS=2.0
#PROCESS_ENGINE_LOG_LEVEL=INFO

# Cron. Every engine process watches the schedules in the database and claims a
# firing there, so several are safe — leave this alone unless something else
# should own scheduling.
#PROCESS_ENGINE_WORKER_SCHEDULER=true
