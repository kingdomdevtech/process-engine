# ── Linux container: the designer + its API ───────────────────────────────────
#
# This host serves the UI and the API and executes NOTHING. Every run — a
# schedule, a webhook, the designer's Run button — and every single-step preview
# is written to the shared database, and the Windows engine claims it. So this
# container needs no Excel, no COM, and no Windows.
#
# Install two of the three distributions and not the third:
#   pip install "./packages/process_engine_core[mysql]" ./packages/process_engine_api
# Never process-engine out here — that is the package with the plugin
# implementations in it, and this host is not meant to be able to run one.
#
# Nothing auto-loads this file — feed it to the process manager. With systemd:
#   [Service]
#   EnvironmentFile=/etc/process-engine/linux-api.env
#   ExecStart=/opt/process-engine/.venv/bin/uvicorn "process_engine_api:create_app" \
#             --factory --host 0.0.0.0 --port 8000
# Bind 0.0.0.0 so browsers can reach it; `python -m process_engine_api` binds
# 127.0.0.1 only and is for local use.

# Shared database — the ONE channel between the two hosts. Must be a
# network-reachable MySQL/Postgres (SQLite cannot be shared). Points at the DB
# running on the Windows host.
PROCESS_ENGINE_DB_URL=mysql+pymysql://process_engine:CHANGE_ME@WINDOWS_HOST:3306/process_engine

# Fernet key for secrets and SSO state. MUST be byte-identical to the Windows
# worker's, or the worker cannot decrypt the secrets your steps use. Generate
# once and copy to both hosts:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROCESS_ENGINE_SECRET_KEY=CHANGE_ME_shared_fernet_key

# Static admin bearer token (bootstrap / machine credential). Only the API needs
# it — the worker serves no HTTP.
PROCESS_ENGINE_AUTH_TOKEN=CHANGE_ME_api_token

# Origins. PUBLIC_URL is THIS API's own origin, registered as the OIDC callback
# with the provider. DESIGNER_URL is where the browser lands after SSO and where
# run-notification "Open the run" links point. Same value when this container
# serves the designer too (the default single-origin build); differ only if the
# designer is hosted separately (then set VITE_API_BASE at `npm run build`).
# Set DESIGNER_URL on the Windows engine as well: it sends the run email.
PROCESS_ENGINE_PUBLIC_URL=https://engine.example.com
PROCESS_ENGINE_DESIGNER_URL=https://engine.example.com

# Optional single sign-on. Register {PUBLIC_URL}/api/auth/sso/<provider>/callback
# with the provider. Unset providers simply do not appear on the login screen.
#PROCESS_ENGINE_OIDC_GOOGLE_CLIENT_ID=
#PROCESS_ENGINE_OIDC_GOOGLE_CLIENT_SECRET=
#PROCESS_ENGINE_OIDC_ENTRA_CLIENT_ID=
#PROCESS_ENGINE_OIDC_ENTRA_CLIENT_SECRET=
#PROCESS_ENGINE_OIDC_ENTRA_TENANT=common
#PROCESS_ENGINE_SSO_AUTO_PROVISION=false

# Note what is NOT here: nothing that tunes execution. PROCESS_ENGINE_STEP_WORKERS
# belongs on the engine hosts, because that is the only place a step ever runs.
