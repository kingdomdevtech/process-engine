# Example environment for local development.
# Copy this file to .env and fill in local-only values.

# Shared database and security
PROCESS_ENGINE_DB_URL=mysql+pymysql://process_engine:process_engine@127.0.0.1:3306/process_engine
PROCESS_ENGINE_SECRET_KEY=replace_with_local_fernet_key
PROCESS_ENGINE_AUTH_TOKEN=replace_with_local_api_token

# API and designer origins
PROCESS_ENGINE_PUBLIC_URL=http://127.0.0.1:8000
PROCESS_ENGINE_DESIGNER_URL=http://127.0.0.1:8000

# Filesystem sandbox and runtime tuning
PROCESS_ENGINE_WORK_DIR=./workdir
PROCESS_ENGINE_LOG_LEVEL=INFO
PROCESS_ENGINE_QUEUE_POLL_SECONDS=2.0
PROCESS_ENGINE_STEP_WORKERS=4
PROCESS_ENGINE_RELOAD=true

# Optional local server settings
# PROCESS_ENGINE_HOST=127.0.0.1
# PROCESS_ENGINE_PORT=8000
# PROCESS_ENGINE_DOCS_DIR=docs
# PROCESS_ENGINE_DESIGNER_DIST=designer/dist

# Optional worker scheduler setting
# PROCESS_ENGINE_WORKER_SCHEDULER=true

# Optional OpenID Connect providers for SSO
# PROCESS_ENGINE_OIDC_GOOGLE_CLIENT_ID=
# PROCESS_ENGINE_OIDC_GOOGLE_CLIENT_SECRET=
# PROCESS_ENGINE_OIDC_ENTRA_CLIENT_ID=
# PROCESS_ENGINE_OIDC_ENTRA_CLIENT_SECRET=
# PROCESS_ENGINE_OIDC_ENTRA_TENANT=common
# PROCESS_ENGINE_SSO_AUTO_PROVISION=false
